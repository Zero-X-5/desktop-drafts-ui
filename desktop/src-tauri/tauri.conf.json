{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "拾笺",
  "version": "0.1.0",
  "identifier": "com.shijian.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "拾笺",
        "width": 286,
        "height": 640,
        "minWidth": 286,
        "minHeight": 64,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": false
      },
      {
        "label": "preview",
        "title": "拾笺预览",
        "url": "index.html?preview=1",
        "width": 500,
        "height": 640,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "skipTaskbar": true,
        "visible": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

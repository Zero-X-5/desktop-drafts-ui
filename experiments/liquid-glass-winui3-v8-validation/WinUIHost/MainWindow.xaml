<Window
    x:Class="LiquidGlassWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Liquid Glass Test Window">

    <Grid
        x:Name="RootGrid"
        MinWidth="400"
        MinHeight="440"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <StackPanel
            Width="360"
            Margin="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Spacing="8">

            <TextBlock
                Text="Liquid Glass Test Window"
                FontSize="18"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="V9 reference and 248×36 long bar · same live desktop"
                FontSize="11"
                Opacity="0.58"/>

            <TextBlock
                Margin="0,10,0,0"
                Text="V9 REFERENCE · 186×60"
                FontSize="11"
                FontWeight="SemiBold"
                Opacity="0.72"/>

            <!-- Exact sealed V9 sample: 274x148 host, 186x60 lens. -->
            <Grid
                x:Name="GlassContainer"
                Width="274"
                Height="148"
                HorizontalAlignment="Center">

                <Grid
                    x:Name="GlassSurfaceHost"
                    IsHitTestVisible="False"/>

                <Button
                    x:Name="GlassButton"
                    Width="186"
                    Height="60"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    RenderTransformOrigin="0.5,0.5"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    PointerPressed="GlassButton_PointerPressed"
                    PointerReleased="GlassButton_PointerReleased"
                    PointerCanceled="GlassButton_PointerCanceled"
                    Click="GlassButton_Click">

                    <Button.RenderTransform>
                        <ScaleTransform
                            x:Name="GlassButtonScale"
                            ScaleX="1"
                            ScaleY="1"/>
                    </Button.RenderTransform>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <StackPanel
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                                    <TextBlock
                                        Text="Generate"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        VerticalAlignment="Center"/>
                                    <PathIcon
                                        Width="20"
                                        Height="20"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Data="M13,2 L3,14 L12,14 L11,22 L21,10 L12,10 Z"/>
                                </StackPanel>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Rectangle
                Height="1"
                Margin="0,6"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <TextBlock
                Text="LONG BAR · 248×36"
                FontSize="11"
                FontWeight="SemiBold"
                Opacity="0.72"/>

            <TextBlock
                Text="V9 recipe · 0.60× spatial optics"
                FontSize="10"
                Opacity="0.48"/>

            <!-- 44px V9 optical margin around the 248x36 long-bar lens. -->
            <Grid
                x:Name="LongBarContainer"
                Width="336"
                Height="124"
                HorizontalAlignment="Center">
                <Grid
                    x:Name="LongBarSurfaceHost"
                    IsHitTestVisible="False"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
